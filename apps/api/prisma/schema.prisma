// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 유저 종류
enum Role {
  STUDENT
  COACH
  ADMIN
}

// 보컬 티어 종류
enum VocalTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

// 코치 활동 지역
enum Region {
  SEOUL    // 서울
  GYEONGGI // 경기
  INCHEON  // 인천
}

// 유저 테이블
model User {
  id             String         @id @db.Uuid // PK. Supabase Auth의 auth.users.id(UUID)와 동일하게 채운다 (자동생성 X)
  kakaoId        String         @unique // 카카오 아이디
  nickname       String                 
  role           Role           @default(STUDENT) // 권한
  createdAt      DateTime       @default(now()) // 계정 생성 일자
  lessonRequests LessonRequest[] // 1:N 관계 필드 (가상 — DB에 컬럼 안 생김)
  coachProfile   CoachProfile?  // 코치일 때만 존재 (가상 — DB 컬럼 안 생김)
}

// 레슨 신청 테이블
model LessonRequest {
  id           String     @id @default(cuid()) // PK (Primary Key)
  studentId       String     @db.Uuid // FK (Foreign Key) — User.id(UUID)와 타입 일치
  student         User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  region       String // 희망 레슨 지역
  goal         String // 레슨 목표
  genre        String // 선호 장르
  voiceAudioUrl     String // 녹음 파일 url
  studentName  String // 레슨생 이름
  studentPhone String // 레슨생 전화번호
  tier         VocalTier? // 보컬 평가 (평가 이전에는 null)
  createdAt    DateTime   @default(now()) // 레슨 신청일자 (업로드 횟수 제한/복구 정렬에 사용)

  @@index([studentId])
}

// 코치 프로필 테이블 (User와 1:1, COACH일 때만 존재)
model CoachProfile {
  id           String   @id @default(cuid())
  userId       String   @unique @db.Uuid // FK + 1:1 보장 — User.id(UUID)와 타입 일치
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityName String // 활동명
  region       Region // 활동 지역
  createdAt    DateTime @default(now())
}
