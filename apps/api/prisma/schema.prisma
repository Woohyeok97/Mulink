// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 유저 종류
enum Role {
  STUDENT
  COACH
  ADMIN
}

// 보컬 티어 종류
enum VocalTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

// 코치 활동 지역
enum Region {
  // 수도권
  SEOUL    // 서울
  GYEONGGI // 경기
  INCHEON  // 인천

  // 영남권
  BUSAN    // 부산
  DAEGU    // 대구
  ULSAN    // 울산

  // 호남권
  GWANGJU  // 광주

  // 충청권
  DAEJEON  // 대전
}

// 선호 장르
enum Genre {
  POP
  BALLAD
  ROCK
  RNB
  JAZZ
  HIPHOP
  TROT
}

// 유저 테이블
model User {
  id             String         @id @db.Uuid // PK. Supabase Auth의 auth.users.id(UUID)와 동일하게 채운다 (자동생성 X)
  kakaoId        String         @unique // 카카오 아이디
  nickname       String                 
  role           Role           @default(STUDENT) // 권한
  createdAt      DateTime       @default(now()) // 계정 생성 일자
  lessonRequests  LessonRequest[]  // 1:N 관계 필드 (가상 — DB에 컬럼 안 생김)
  lessonProposals LessonProposal[] // 코치로서 보낸 제안들 (가상 — DB 컬럼 안 생김)
  coachProfile    CoachProfile?    // 코치일 때만 존재 (가상 — DB 컬럼 안 생김)
}

// 코치 프로필 테이블 (User와 1:1, COACH일 때만 존재)
model CoachProfile {
  id           String   @id @default(cuid())
  userId       String   @unique @db.Uuid // FK + 1:1 보장 — User.id(UUID)와 타입 일치
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityName String // 활동명
  imageUrl     String? // 프로필 이미지 S3 공개 URL (선택 — 미등록 시 null)
  region       Region // 활동 지역
  createdAt    DateTime @default(now())
}

// 레슨 신청 테이블
model LessonRequest {
  id        String           @id @default(cuid()) // PK (Primary Key)
  studentId String           @unique @db.Uuid // FK — User.id(UUID)와 타입 일치. unique로 1인 1신청을 DB에서 보장
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  region    Region // 희망 레슨 지역
  goal      String // 레슨 목표
  genre     Genre // 선호 장르
  createdAt DateTime         @default(now()) // 레슨 신청일자
  proposals LessonProposal[] // 이 신청에 들어온 제안들 (가상 — DB 컬럼 안 생김)
}

// 레슨 제안 테이블 (코치가 특정 레슨 신청에 보낸 제안)
model LessonProposal {
  id        String        @id @default(cuid()) // PK
  requestId String // FK — LessonRequest.id
  request   LessonRequest @relation(fields: [requestId], references: [id], onDelete: Cascade) // 신청 삭제 시 제안도 함께 삭제
  coachId   String        @db.Uuid // FK — User.id(UUID)와 타입 일치
  coach     User          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  message   String // 제안 한마디
  createdAt DateTime      @default(now()) // 제안 보낸 시각 (최신순 정렬용)

  @@unique([requestId, coachId]) // 1신청 1제안 — 같은 코치가 같은 신청에 중복 제안 불가
  @@index([requestId])
  @@index([coachId])
}


