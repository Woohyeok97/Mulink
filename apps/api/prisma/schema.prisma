// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 유저 종류
enum Role {
  STUDENT
  COACH
  ADMIN
}

// 보컬 티어 종류
enum VocalTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

// 코치 활동 지역
enum Region {
  // 수도권
  SEOUL // 서울
  GYEONGGI // 경기
  INCHEON // 인천

  // 영남권
  BUSAN // 부산
  DAEGU // 대구
  ULSAN // 울산

  // 호남권
  GWANGJU // 광주

  // 충청권
  DAEJEON // 대전
}

// 선호 장르
enum Genre {
  POP
  BALLAD
  ROCK
  RNB
  JAZZ
  HIPHOP
  TROT
}

// 유저 테이블
model User {
  id               String           @id @db.Uuid // PK. Supabase Auth의 auth.users.id(UUID)와 동일하게 채운다 (자동생성 X)
  kakaoId          String           @unique // 카카오 아이디
  nickname         String
  role             Role             @default(STUDENT) // 권한
  createdAt        DateTime         @default(now()) // 계정 생성 일자
  lessonRequests   LessonRequest[] // 1:N 관계 필드 (가상 — DB에 컬럼 안 생김)
  lessonProposals  LessonProposal[] // 코치로서 보낸 제안들 (가상 — DB 컬럼 안 생김)
  coachProfile     CoachProfile? // 코치일 때만 존재 (가상 — DB 컬럼 안 생김)
  studentChatRooms ChatRoom[]       @relation("StudentChatRooms") // 학생으로서 참여한 방 (가상 — DB 컬럼 안 생김)
  coachChatRooms   ChatRoom[]       @relation("CoachChatRooms") // 코치로서 참여한 방 (가상 — DB 컬럼 안 생김)
  chatMessages     ChatMessage[] // 보낸 메시지들 (가상 — DB 컬럼 안 생김)
}

// 코치 프로필 테이블 (User와 1:1, COACH일 때만 존재)
model CoachProfile {
  id           String   @id @default(cuid())
  userId       String   @unique @db.Uuid // FK + 1:1 보장 — User.id(UUID)와 타입 일치
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityName String // 활동명
  imageUrl     String? // 프로필 이미지 S3 공개 URL (선택 — 미등록 시 null)
  region       Region // 활동 지역
  createdAt    DateTime @default(now())
}

// 레슨 신청 테이블
model LessonRequest {
  id        String           @id @default(cuid()) // PK (Primary Key)
  studentId String           @unique @db.Uuid // FK — User.id(UUID)와 타입 일치. unique로 1인 1신청을 DB에서 보장
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  region    Region // 희망 레슨 지역
  goal      String // 레슨 목표
  genre     Genre // 선호 장르
  createdAt DateTime         @default(now()) // 레슨 신청일자
  proposals LessonProposal[] // 이 신청에 들어온 제안들 (가상 — DB 컬럼 안 생김)
}

// 레슨 제안 테이블 (코치가 특정 레슨 신청에 보낸 제안)
model LessonProposal {
  id        String        @id @default(cuid()) // PK
  requestId String // FK — LessonRequest.id
  request   LessonRequest @relation(fields: [requestId], references: [id], onDelete: Cascade) // 신청 삭제 시 제안도 함께 삭제
  coachId   String        @db.Uuid // FK — User.id(UUID)와 타입 일치
  coach     User          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  message   String // 제안 한마디
  createdAt DateTime      @default(now()) // 제안 보낸 시각 (최신순 정렬용)
  chatRoom  ChatRoom? // 이 제안으로 열린 채팅방 (가상 — DB 컬럼 안 생김)

  @@unique([requestId, coachId]) // 1신청 1제안 — 같은 코치가 같은 신청에 중복 제안 불가
  @@index([requestId])
  @@index([coachId])
}

// 채팅방 테이블 (학생이 특정 제안에서 "채팅하기"를 눌렀을 때 생성, 1제안 1방)
model ChatRoom {
  id                       String         @id @default(cuid())
  proposalId               String         @unique // FK + 1:1 보장 — 한 제안(학생-코치 쌍)당 방 1개를 DB에서 보장
  proposal                 LessonProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade) // 제안 삭제 시 방도 삭제 (제안 취소·신청 삭제·코치 전환 모두 이 경로로 정리)
  studentId                String         @db.Uuid // FK — User.id(UUID)와 타입 일치
  student                  User           @relation("StudentChatRooms", fields: [studentId], references: [id], onDelete: Cascade)
  coachId                  String         @db.Uuid // FK — User.id(UUID)와 타입 일치
  coach                    User           @relation("CoachChatRooms", fields: [coachId], references: [id], onDelete: Cascade)
  studentLastReadMessageId Int? // 학생이 마지막으로 읽은 메시지 id. ChatMessage.id를 가리키지만 FK는 안 걸고 단순 Int 커서 (읽은 메시지가 지워져도 커서 값만 남으면 됨)
  coachLastReadMessageId   Int? // 코치가 마지막으로 읽은 메시지 id. 위와 동일한 단순 Int 커서
  createdAt                DateTime       @default(now())
  messages                 ChatMessage[] // 이 방에 오간 메시지들 (가상 — DB 컬럼 안 생김)

  @@index([studentId]) // 내 채팅 목록 조회용
  @@index([coachId]) // 내 채팅 목록 조회용
}

// 채팅 메시지 테이블 (텍스트 전용)
model ChatMessage {
  // id는 이 스키마에서 유일하게 자동증가 Int다 (다른 모델은 cuid). 이유: 재연결 후 유실 복구 시
  // "이 id 이후 메시지"(?after=<id>)를 단조증가 정수로 단순 조회(WHERE id > ?)하기 위함
  id        Int      @id @default(autoincrement())
  roomId    String // FK — ChatRoom.id
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade) // 방 삭제 시 메시지도 삭제
  senderId  String   @db.Uuid // FK — User.id(UUID)와 타입 일치
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String // 메시지 내용
  createdAt DateTime @default(now())

  @@index([roomId, id]) // 방별 메시지를 id 순으로 훑는 내역 조회·재동기화의 핵심 인덱스
}
